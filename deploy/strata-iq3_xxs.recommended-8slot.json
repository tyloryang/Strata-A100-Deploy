{
  "_说明": "高并发变体（短提示 / 问答场景，8 槽）。相对 4 槽版只改三处：parallel 4→8、--batch 4→8、--conversation-cache-slots 4→8。对应实测 v5：B 轮（自然中文 in≈800）并发 8 聚合 89.3 tok/s（4 槽为 80.7）。每个参数的含义见 docs/参数详解.md。",
  "_代价": "长提示不要用这套：A 轮（in=2000）并发 8 聚合从 59.5 掉到 56.4，TPOT 从 45.89 ms 涨到 94.71 ms（单流约 10.6 tok/s）。",
  "_注意": [
    "8 槽每槽会话状态占 0.51 GiB × 2 卡；--kv-resident 32768 必须保留，否则每槽涨到 1.86 GiB，显存被推到 99% 并把专家挤出显存（v10 实测）。",
    "--kv-resident 让每个槽位的完整 KV 放在锁页内存（官方约 13.7 KB/token，262144 上下文约 3.6 GB/槽），8 槽比 4 槽多占不少内存；加上会话缓存 16384 MiB，可用内存可能压到 20 GB 以下，要盯 free -h。",
    "单轮基准测试建议把会话缓存关小（本机观察到 --conversation-cache-mib 0 仍会停放会话，不能指望设 0 就关掉）。",
    "其余注意事项与 strata-iq3_xxs.recommended.json 相同（ESP 可选且默认关闭、TAIL_SKIP、已删除的 ADAPT_OVERLAP、batch-mtp）。"
  ],

  "exe": "/data/Strata/engine-cuda12/strata",
  "cwd": "/data/Strata",
  "tokenizer": "/data/Strata-data/packs/iq3_xxs/tokenizer",
  "model_name": "qwen3.8-flash-next-iq3_xxs",
  "log": "/data/Strata/strata-iq3_xxs.log",
  "lib_dirs": [
    "/usr/local/cuda/bin",
    "/usr/local/cuda/lib64"
  ],
  "port": 8080,
  "cuda": 12,
  "gpu": [0, 1],
  "gpus_asked": true,
  "layer_split": "auto",
  "host": "0.0.0.0",

  "args": [
    "--pack", "/data/Strata-data/packs/iq3_xxs",
    "--native", "/data/Strata-data/models/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00001-of-00002.gguf",
    "--ple-gguf", "/data/Strata-data/models/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_XXS-00002-of-00002.gguf",
    "--expert-profile", "/data/Strata/data/expert-profile.bin",
    "--expert-cache", "auto",
    "--prefill", "auto:32768",
    "--spec", "4",
    "--spec-min-p", "0.5",
    "--mtp", "/data/Strata-data/mtp/rt",
    "--max-context", "262144",
    "--resident-experts",
    "--conversation-cache-mib", "16384",
    "--conversation-cache-slots", "8",
    "--conversation-cache-min-tokens", "4096",
    "--conversation-cache-park-gain", "2048",
    "--kv-resident", "32768",
    "--kv", "int8",
    "--ple-io", "mmap",
    "--control-vector-scaled", "/data/Strata/data/experimental-speed-projection/Qwen3.8-Flash-Next-experimental-speed-projection.gguf:1.0",
    "--control-vector-layer-range", "4", "44",
    "--cvec-mode", "project",
    "--cvec-dir", "per-layer",
    "--batch", "8"
  ],

  "env": {
    "STRATA_ROUTE_TAIL_SKIP": "0",
    "STRATA_RESIDENT_HEADROOM_GIB": "2",
    "MALLOC_MMAP_THRESHOLD_": "16777216"
  },

  "reasoning_effort": "medium",
  "reasoning_budget_tokens": 4096,
  "reasoning_close_retry": true,
  "fit_max_tokens": true,

  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "experimental_speed_projection": false
  },

  "parallel": 8,
  "api_key": "REPLACE_WITH_API_KEY",
  "open_browser": false
}
