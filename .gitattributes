# 统一 LF：脚本要在 Linux 上直接执行
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.md   text eol=lf

# Preserve the exact measured upstream client bytes, including docstring spaces.
tools/vllm-benchmark-client/benchmark_serving.py whitespace=-blank-at-eol

*.png  binary
*.gguf binary
*.tar  binary
